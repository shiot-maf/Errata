rules_version = '2';

// Echo Diary — 일기는 본인만 읽고 쓴다. 다른 사람의 문서에는 아예 닿지 못한다.
service cloud.firestore {
  match /databases/{database}/documents {

    match /diaryUsers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
